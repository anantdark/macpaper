class MacpaperParser(argparse.ArgumentParser):
    """Friendlier errors: suggestions, no raw argparse dump on typos."""

    def error(self, message: str) -> None:  # type: ignore[override]
        unknown = None
        if "invalid choice:" in message:
            try:
                unknown = message.split("invalid choice:", 1)[1].strip().split()[0].strip("'\"")
            except IndexError:
                unknown = None
        elif "unrecognized arguments:" in message:
            try:
                unknown = message.split("unrecognized arguments:", 1)[1].strip().split()[0]
            except IndexError:
                unknown = None

        # Infer active command from argv (subparser prog is not always set usefully)
        active_cmd = None
        for tok in sys.argv[1:]:
            if tok.startswith("-"):
                continue
            resolved = resolve_command(tok)
            if resolved and resolved not in {"help", "version"}:
                active_cmd = resolved
                break

        print(f"{S.red('✗')} {S.bold('error:')} {message}", file=sys.stderr)
        if unknown:
            if unknown.startswith("-"):
                target = f"macpaper {active_cmd} --help" if active_cmd else "macpaper help"
                print(
                    f"  {S.dim('hint:')} Unknown flag. Run {S.cyan(target)} to see valid options.",
                    file=sys.stderr,
                )
            else:
                hint = suggest_command(unknown)
                if hint:
                    print(f"  {S.dim('hint:')} {hint}", file=sys.stderr)
                else:
                    print(
                        f"  {S.dim('hint:')} Run {S.cyan('macpaper help')} to see available commands.",
                        file=sys.stderr,
                    )
        elif "required" in message and "folder" in message:
            example_cmd = active_cmd or "register"
            print(
                f"  {S.dim('hint:')} Example: {S.cyan(f'macpaper {example_cmd} ~/Movies/Wallpapers')}",
                file=sys.stderr,
            )
        else:
            print(
                f"  {S.dim('hint:')} Run {S.cyan('macpaper help')} or {S.cyan('macpaper')} for usage.",
                file=sys.stderr,
            )
        raise SystemExit(2)

    def print_help(self, file=None) -> None:  # type: ignore[override]
        if self.prog == "macpaper":
            print_banner_help()
        else:
            super().print_help(file)


def build_parser() -> MacpaperParser:
    p = MacpaperParser(
        prog="macpaper",
        description="Register local videos & images in macOS Wallpaper / Screen Saver.",
        add_help=False,  # we handle help ourselves for a consistent brand
    )
    sub = p.add_subparsers(
        dest="cmd",
        required=False,
        metavar="command",
        parser_class=MacpaperParser,
    )

    def add_cmd(name: str, help_text: str, handler: Callable, aliases: Sequence[str] = ()) -> argparse.ArgumentParser:
        sp = sub.add_parser(
            name,
            help=help_text,
            aliases=list(aliases),
            formatter_class=argparse.RawDescriptionHelpFormatter,
        )
        sp.set_defaults(func=handler)
        return sp

    r = add_cmd(
        "register",
        "Register a folder of videos/images",
        cmd_register,
        aliases=("add", "install"),
    )
    r.add_argument("folder", help="Folder containing videos and/or images")
    r.add_argument("--name", help="Category name in Wallpaper settings (default: folder name)")
    r.add_argument("--videos-only", action="store_true", help="Only register videos as aerials")
    r.add_argument("--images-only", action="store_true", help="Only register the folder for still images")
    r.add_argument(
        "--no-transcode",
        action="store_true",
        help="Copy/link as-is (skip temporal HEVC encode; wallpaper freeze may not work)",
    )
    r.add_argument(
        "--force-transcode",
        action="store_true",
        help="Always re-encode with temporal layers (needed to fix already-registered clips)",
    )
    r.add_argument(
        "--quality",
        choices=sorted(QUALITY_PRESETS.keys()),
        default=DEFAULT_QUALITY,
        help=f"Temporal HEVC bitrate preset when encoding (default: {DEFAULT_QUALITY})",
    )
    save_group = r.add_mutually_exclusive_group()
    save_group.add_argument(
        "--save-transcoded",
        action="store_true",
        help=f"Also copy encodes into <folder>/{TRANSCODED_DIR_NAME}/",
    )
    save_group.add_argument(
        "--no-save-transcoded",
        action="store_true",
        help=f"Do not write copies under <folder>/{TRANSCODED_DIR_NAME}/ (skip prompt)",
    )
    r.add_argument("--no-restart", action="store_true", help="Do not restart WallpaperAgent")
    r.add_argument("--dry-run", action="store_true", help="Show what would be done")
    r.epilog = "Example:\n  macpaper register ~/Movies/Wallpapers --name \"My Wallpapers\""

    u = add_cmd(
        "unregister",
        "Remove a registered folder, or one video (asset id / path / name)",
        cmd_unregister,
        aliases=("rm", "remove", "delete"),
    )
    u.add_argument(
        "folder",
        help="Registered folder path, or asset UUID / source path / filename to remove one video",
    )
    u.add_argument("--force", action="store_true", help="Scrub even if not in macpaper state")
    u.add_argument("-y", "--yes", action="store_true", help="Skip confirmation prompt")
    u.add_argument("--dry-run", action="store_true", help="Show what would be removed")
    u.add_argument("--no-restart", action="store_true", help="Do not restart WallpaperAgent")
    u.epilog = (
        "Examples:\n"
        "  macpaper unregister ~/Movies/Wallpapers\n"
        "  macpaper unregister B5F705B9-5A54-5FBF-B3A3-54EEB78C473D\n"
        "  macpaper unregister sunset.mp4"
    )

    uv = add_cmd(
        "unregister-video",
        "Remove one source video from Wallpaper / Screen Saver",
        cmd_unregister_video,
        aliases=("rm-video", "remove-video", "delete-video"),
    )
    uv.add_argument(
        "folder",
        help="Registered folder, or alone: asset UUID / source path / filename",
    )
    uv.add_argument(
        "video",
        nargs="?",
        default=None,
        help="Source video name when folder is given (optional if folder is an id/path/name)",
    )
    uv.add_argument("--dry-run", action="store_true", help="Show what would be removed")
    uv.add_argument("-y", "--yes", action="store_true", help="Skip confirmation prompt")
    uv.add_argument("--no-restart", action="store_true", help="Do not restart WallpaperAgent")
    uv.epilog = (
        "Examples:\n"
        "  macpaper unregister-video B5F705B9-5A54-5FBF-B3A3-54EEB78C473D\n"
        "  macpaper unregister-video ~/Movies/clip.mp4\n"
        "  macpaper unregister-video ~/Movies/Wallpapers sunset"
    )

    ck = add_cmd(
        "check",
        "Check if videos are full aerial-ready (HEVC + temporal layers)",
        cmd_check,
        aliases=("inspect", "probe"),
    )
    ck.add_argument("path", help="Video file or folder to inspect")
    ck.epilog = (
        "Full ready = HEVC with temporal sub-layers (tscl/tsas).\n"
        "Plain HEVC works as screensaver only; wallpaper freeze needs re-encode.\n"
        "Example:\n  macpaper check ~/Movies/clip.mp4"
    )

    add_cmd("list", "List registered folders / custom aerials", cmd_list, aliases=("ls", "status"))
    add_cmd("refresh", "Restart WallpaperAgent so Settings reloads", cmd_refresh, aliases=("reload", "restart"))
    add_cmd("help", "Show help", cmd_help)
    add_cmd("version", "Print version", cmd_version)

    return p


def main(argv: list[str] | None = None) -> None:
    argv = list(sys.argv[1:] if argv is None else argv)

    # Bare invocation → interactive help / guided menu
    if not argv:
        argv = interactive_menu()

    head = argv[0] if argv else ""
    head_l = head.lower()

    # Global help / version (not `macpaper register --help`)
    if head_l in {"-h", "--help", "help"} and len(argv) == 1:
        print_banner_help()
        return
    if head_l in {"-v", "--version", "version"} and len(argv) == 1:
        cmd_version()
        return

    # Unknown top-level command → soft fail with suggestion
    known = {
        "register",
        "unregister",
        "unregister-video",
        "check",
        "list",
        "refresh",
        "help",
        "version",
        "add",
        "install",
        "rm",
        "remove",
        "delete",
        "rm-video",
        "remove-video",
        "delete-video",
        "inspect",
        "probe",
        "ls",
        "status",
        "reload",
        "restart",
    }
    if argv and not argv[0].startswith("-") and argv[0].lower() not in known:
        token = argv[0]
        hint = suggest_command(token)
        die(
            f"unknown command “{token}”",
            hint=hint or f"Run {S.cyan('macpaper help')} to see available commands.",
        )

    parser = build_parser()
    args = parser.parse_args(argv)

    if not getattr(args, "cmd", None) or not getattr(args, "func", None):
        print_banner_help()
        return

    try:
        args.func(args)
    except BrokenPipeError:
        # `macpaper list | head` etc.
        raise SystemExit(0)


if __name__ == "__main__":
    main()
