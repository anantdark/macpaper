def _prompt(label: str, default: str | None = None) -> str:
    suffix = f" [{default}]" if default else ""
    try:
        raw = input(f"  {S.cyan('›')} {label}{suffix}: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        raise SystemExit(130)
    if not raw and default is not None:
        return default
    return raw


def _prompt_yes_no(label: str, default: bool = False) -> bool:
    hint = "Y/n" if default else "y/N"
    ans = _prompt(f"{label} ({hint})", "").lower()
    if not ans:
        return default
    return ans in {"y", "yes"}


def interactive_menu() -> list[str]:
    """Guided prompt that returns an argv-like list for the chosen command."""
    print_banner_help()
    if not sys.stdin.isatty():
        return ["help"]

    print(f"  {S.bold('What would you like to do?')}")
    print(f"    {S.cyan('1')}  Register a folder")
    print(f"    {S.cyan('2')}  Unregister a folder")
    print(f"    {S.cyan('3')}  List registered media")
    print(f"    {S.cyan('4')}  Refresh WallpaperAgent")
    print(f"    {S.cyan('5')}  Quit")
    print()

    choice = _prompt("Choose 1–5", "1")
    mapping = {
        "1": "register",
        "2": "unregister",
        "3": "list",
        "4": "refresh",
        "5": "quit",
        "register": "register",
        "unregister": "unregister",
        "list": "list",
        "refresh": "refresh",
        "quit": "quit",
        "q": "quit",
    }
    cmd = mapping.get(choice.lower())
    if cmd is None:
        hint = suggest_command(choice)
        die(f"unknown choice “{choice}”", hint=hint or "Enter a number from 1–5.")
    if cmd == "quit":
        print(f"  {S.dim('Bye.')}")
        raise SystemExit(0)

    argv = [cmd]
    if cmd in {"register", "unregister"}:
        folder = _prompt("Folder path")
        if not folder:
            die("a folder path is required", hint="Example: ~/Movies/Wallpapers")
        argv.append(folder)
        if cmd == "register":
            name = _prompt("Category name (optional, Enter to skip)", "")
            if name:
                argv.extend(["--name", name])
            if _prompt_yes_no("Videos only?", False):
                argv.append("--videos-only")
            elif _prompt_yes_no("Images only?", False):
                argv.append("--images-only")
            if _prompt_yes_no("Dry run (preview only)?", False):
                argv.append("--dry-run")
        print()
        print(f"  {S.dim('Running:')} macpaper {' '.join(argv)}")
        print()
    return argv


# ── argparse ──────────────────────────────────────────────────────────────────


class MacpaperParser(argparse.ArgumentParser):
    """Friendlier errors: suggestions, no raw argparse dump on typos."""

    def error(self, message: str) -> None:  # type: ignore[override]
        unknown = None
        if "invalid choice:" in message:
            try:
                unknown = message.split("invalid choice:", 1)[1].strip().split()[0].strip("'\"")
            except IndexError:
                unknown = None
        elif "unrecognized arguments:" in message:
            try:
                unknown = message.split("unrecognized arguments:", 1)[1].strip().split()[0]
            except IndexError:
                unknown = None

        # Infer active command from argv (subparser prog is not always set usefully)
        active_cmd = None
        for tok in sys.argv[1:]:
            if tok.startswith("-"):
                continue
            resolved = resolve_command(tok)
            if resolved and resolved not in {"help", "version"}:
                active_cmd = resolved
                break

        print(f"{S.red('✗')} {S.bold('error:')} {message}", file=sys.stderr)
        if unknown:
            if unknown.startswith("-"):
                target = f"macpaper {active_cmd} --help" if active_cmd else "macpaper help"
                print(
                    f"  {S.dim('hint:')} Unknown flag. Run {S.cyan(target)} to see valid options.",
                    file=sys.stderr,
                )
            else:
                hint = suggest_command(unknown)
                if hint:
                    print(f"  {S.dim('hint:')} {hint}", file=sys.stderr)
                else:
                    print(
                        f"  {S.dim('hint:')} Run {S.cyan('macpaper help')} to see available commands.",
                        file=sys.stderr,
                    )
        elif "required" in message and "folder" in message:
            example_cmd = active_cmd or "register"
            print(
                f"  {S.dim('hint:')} Example: {S.cyan(f'macpaper {example_cmd} ~/Movies/Wallpapers')}",
                file=sys.stderr,
            )
        else:
            print(
                f"  {S.dim('hint:')} Run {S.cyan('macpaper help')} or {S.cyan('macpaper')} for usage.",
                file=sys.stderr,
            )
        raise SystemExit(2)

    def print_help(self, file=None) -> None:  # type: ignore[override]
        if self.prog == "macpaper":
            print_banner_help()
        else:
            super().print_help(file)


def build_parser() -> MacpaperParser:
    p = MacpaperParser(
        prog="macpaper",
        description="Register local videos & images in macOS Wallpaper / Screen Saver.",
        add_help=False,  # we handle help ourselves for a consistent brand
    )
    sub = p.add_subparsers(
        dest="cmd",
        required=False,
        metavar="command",
        parser_class=MacpaperParser,
    )

    def add_cmd(name: str, help_text: str, handler: Callable, aliases: Sequence[str] = ()) -> argparse.ArgumentParser:
        sp = sub.add_parser(
            name,
            help=help_text,
            aliases=list(aliases),
            formatter_class=argparse.RawDescriptionHelpFormatter,
        )
        sp.set_defaults(func=handler)
        return sp

    r = add_cmd(
        "register",
        "Register a folder of videos/images",
        cmd_register,
        aliases=("add", "install"),
    )
    r.add_argument("folder", help="Folder containing videos and/or images")
    r.add_argument("--name", help="Category name in Wallpaper settings (default: folder name)")
    r.add_argument("--videos-only", action="store_true", help="Only register videos as aerials")
    r.add_argument("--images-only", action="store_true", help="Only register the folder for still images")
    r.add_argument("--no-transcode", action="store_true", help="Copy/link as-is (skip HEVC encode)")
    r.add_argument("--force-transcode", action="store_true", help="Always re-encode to HEVC")
    r.add_argument("--no-restart", action="store_true", help="Do not restart WallpaperAgent")
    r.add_argument("--dry-run", action="store_true", help="Show what would be done")
    r.epilog = "Example:\n  macpaper register ~/Movies/Wallpapers --name \"My Wallpapers\""

    u = add_cmd(
        "unregister",
        "Remove a previously registered folder",
        cmd_unregister,
        aliases=("rm", "remove", "delete"),
    )
    u.add_argument("folder", help="Folder previously passed to register")
    u.add_argument("--force", action="store_true", help="Scrub even if not in macpaper state")
    u.add_argument("--no-restart", action="store_true", help="Do not restart WallpaperAgent")

    add_cmd("list", "List registered folders / custom aerials", cmd_list, aliases=("ls", "status"))
    add_cmd("refresh", "Restart WallpaperAgent so Settings reloads", cmd_refresh, aliases=("reload", "restart"))
    add_cmd("help", "Show help", cmd_help)
    add_cmd("version", "Print version", cmd_version)

    return p


def main(argv: list[str] | None = None) -> None:
    argv = list(sys.argv[1:] if argv is None else argv)

    # Bare invocation → interactive help / guided menu
    if not argv:
        argv = interactive_menu()

    head = argv[0] if argv else ""
    head_l = head.lower()

    # Global help / version (not `macpaper register --help`)
    if head_l in {"-h", "--help", "help"} and len(argv) == 1:
        print_banner_help()
        return
    if head_l in {"-v", "--version", "version"} and len(argv) == 1:
        cmd_version()
        return

    # Unknown top-level command → soft fail with suggestion
    known = {
        "register",
        "unregister",
        "list",
        "refresh",
        "help",
        "version",
        "add",
        "install",
        "rm",
        "remove",
        "delete",
        "ls",
        "status",
        "reload",
        "restart",
    }
    if argv and not argv[0].startswith("-") and argv[0].lower() not in known:
        token = argv[0]
        hint = suggest_command(token)
        die(
            f"unknown command “{token}”",
            hint=hint or f"Run {S.cyan('macpaper help')} to see available commands.",
        )

    parser = build_parser()
    args = parser.parse_args(argv)

    if not getattr(args, "cmd", None) or not getattr(args, "func", None):
        print_banner_help()
        return

    try:
        args.func(args)
    except BrokenPipeError:
        # `macpaper list | head` etc.
        raise SystemExit(0)


if __name__ == "__main__":
    main()
