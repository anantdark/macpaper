def is_under_skipped_dir(path: Path) -> bool:
    """True if any path component is a reserved dir (e.g. transcoded/)."""
    return any(part.lower() in SKIP_DIR_NAMES for part in path.parts)


def scan_folder(folder: Path) -> tuple[list[Path], list[Path]]:
    """List media in folder. Skips reserved dirs like transcoded/."""
    videos: list[Path] = []
    images: list[Path] = []
    for p in sorted(folder.iterdir()):
        if p.name.startswith("."):
            continue
        if p.is_dir():
            # Never descend into reserved output folders
            if p.name.lower() in SKIP_DIR_NAMES:
                continue
            continue  # top-level files only (dirs other than skipped are ignored)
        if not p.is_file() or is_under_skipped_dir(p):
            continue
        ext = p.suffix.lower()
        if ext in VIDEO_EXTS:
            videos.append(p)
        elif ext in IMAGE_EXTS:
            images.append(p)
    return videos, images


def resolve_save_transcoded(args: argparse.Namespace) -> bool:
    """Whether to keep a local copy under <folder>/transcoded/."""
    if getattr(args, "save_transcoded", False):
        return True
    if getattr(args, "no_save_transcoded", False):
        return False
    if sys.stdin.isatty() and sys.stdout.isatty():
        return _prompt_yes_no(
            f"Also save transcoded videos into ./{TRANSCODED_DIR_NAME}/?",
            default=False,
        )
    return False


def save_local_transcode_copy(src: Path, encoded: Path, folder: Path) -> Path:
    """Copy the aerials encode into <folder>/transcoded/<stem>.mov."""
    out_dir = folder / TRANSCODED_DIR_NAME
    out_dir.mkdir(parents=True, exist_ok=True)
    dest = out_dir / f"{src.stem}.mov"
    if dest.resolve() == encoded.resolve():
        return dest
    if dest.exists():
        dest.unlink()
    try:
        os.link(encoded, dest)
    except OSError:
        shutil.copy2(encoded, dest)
    info(f"  saved   {dest.relative_to(folder)}")
    return dest


