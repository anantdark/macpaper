def remove_category_assets(entries: dict[str, Any], category_id: str, subcategory_id: str) -> list[str]:
    """Remove a macpaper category and every asset linked to it.

    Safe vs other apps: macpaper category IDs are deterministic UUIDs under
    CAT_NAMESPACE, so we only ever match entries we created.
    """
    removed_ids: list[str] = []
    keep_assets = []
    for a in entries.get("assets") or []:
        cats = a.get("categories") or []
        subs = a.get("subcategories") or []
        if category_id in cats or subcategory_id in subs:
            removed_ids.append(a["id"])
        else:
            keep_assets.append(a)
    entries["assets"] = keep_assets
    entries["categories"] = [c for c in (entries.get("categories") or []) if c.get("id") != category_id]
    return removed_ids


def remove_single_asset(
    entries: dict[str, Any],
    *,
    asset_id: str,
    category_id: str,
) -> bool:
    """Remove one aerial asset. Updates/drops its category if it becomes empty."""
    assets = list(entries.get("assets") or [])
    kept = [a for a in assets if a.get("id") != asset_id]
    if len(kept) == len(assets):
        return False
    entries["assets"] = kept

    still = [a for a in kept if category_id in (a.get("categories") or [])]
    new_cats: list[dict[str, Any]] = []
    for cat in entries.get("categories") or []:
        if cat.get("id") != category_id:
            new_cats.append(cat)
            continue
        if not still:
            continue  # remove empty macpaper category
        rep = still[0]
        updated = dict(cat)
        updated["representativeAssetID"] = rep["id"]
        updated["previewImage"] = rep.get("previewImage") or updated.get("previewImage")
        subs = []
        for sub in updated.get("subcategories") or []:
            s = dict(sub)
            s["representativeAssetID"] = rep["id"]
            s["previewImage"] = rep.get("previewImage") or s.get("previewImage")
            subs.append(s)
        updated["subcategories"] = subs
        new_cats.append(updated)
    entries["categories"] = new_cats
    return True


def lookup_folder_state(
    state: dict[str, Any], folder: Path
) -> tuple[str, dict[str, Any] | None]:
    key = normalize_path(folder)
    prev = (state.get("folders") or {}).get(key)
    if prev:
        return key, prev
    alt = key[len("/private") :] if key.startswith("/private/") else "/private" + key
    prev = (state.get("folders") or {}).get(alt)
    if prev:
        return alt, prev
    return key, None


def looks_like_uuid(token: str) -> bool:
    """True if token is a UUID string (with or without surrounding path junk)."""
    s = Path(token.strip()).name
    return bool(
        re.fullmatch(
            r"[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}",
            s,
        )
    )


def collect_asset_matches(
    assets: dict[str, Any], video_name: str
) -> tuple[list[tuple[str, dict[str, Any]]], list[tuple[str, dict[str, Any]]]]:
    """Return (exact_matches, partial_matches) for a needle within one folder's assets."""
    needle = video_name.strip()
    if not needle:
        return [], []
    needle_expanded = str(Path(needle).expanduser())
    try:
        needle_resolved = normalize_path(Path(needle).expanduser())
    except (OSError, RuntimeError, ValueError):
        needle_resolved = str(Path(needle).expanduser())
    needle_base = Path(needle_expanded).name
    needle_stem = Path(needle_expanded).stem
    needle_l = needle.lower()
    needle_base_l = needle_base.lower()
    needle_stem_l = needle_stem.lower()
    needle_id = needle_base.upper()

    exact: list[tuple[str, dict[str, Any]]] = []
    partial: list[tuple[str, dict[str, Any]]] = []

    for key, meta in assets.items():
        if not isinstance(meta, dict):
            continue
        src = str(meta.get("source") or "")
        src_name = Path(src).name if src else key
        src_stem = Path(src_name).stem
        title = str(meta.get("title") or "")
        asset_id = str(meta.get("id") or "")
        aerial = str(meta.get("aerial") or "")
        key_l, src_l, stem_l, title_l = (
            key.lower(),
            src_name.lower(),
            src_stem.lower(),
            title.lower(),
        )
        src_norm = normalize_path(src) if src else ""
        aerial_norm = normalize_path(aerial) if aerial else ""

        if (
            needle_expanded == src
            or needle_resolved == src_norm
            or (aerial and (needle_resolved == aerial_norm or needle_base == Path(aerial).name))
            or needle == key
            or needle_base == key
            or needle_base == src_name
            or needle_stem == src_stem
            or needle_base_l == key_l
            or needle_base_l == src_l
            or needle_stem_l == stem_l
            or (asset_id and needle_id == asset_id.upper())
        ):
            exact.append((key, meta))
            continue

        haystacks = (key_l, src_l, stem_l, title_l, asset_id.lower())
        if any(
            needle_l in h or h.startswith(needle_l) or needle_stem_l in h
            for h in haystacks
            if h
        ):
            partial.append((key, meta))

    return exact, partial


def _dedupe_asset_pairs(
    pairs: list[tuple[str, dict[str, Any]]],
) -> list[tuple[str, dict[str, Any]]]:
    seen: set[str] = set()
    out: list[tuple[str, dict[str, Any]]] = []
    for k, m in pairs:
        aid = str(m.get("id") or k)
        if aid in seen:
            continue
        seen.add(aid)
        out.append((k, m))
    return out


def _dedupe_folder_hits(
    hits: list[tuple[str, str, dict[str, Any]]],
) -> list[tuple[str, str, dict[str, Any]]]:
    seen: set[str] = set()
    out: list[tuple[str, str, dict[str, Any]]] = []
    for folder_key, src_name, meta in hits:
        aid = str(meta.get("id") or f"{folder_key}:{src_name}")
        if aid in seen:
            continue
        seen.add(aid)
        out.append((folder_key, src_name, meta))
    return out


def match_tracked_asset(
    assets: dict[str, Any], video_name: str
) -> tuple[str, dict[str, Any]] | None:
    """Find a tracked asset by exact name/path/id, or a unique partial match."""
    exact, partial = collect_asset_matches(assets, video_name)

    exact_u = _dedupe_asset_pairs(exact)
    if len(exact_u) == 1:
        return exact_u[0]
    if len(exact_u) > 1:
        names = ", ".join(k for k, _ in exact_u)
        die(
            f"ambiguous video “{video_name}” matches: {names}",
            hint="Pass a more specific filename or asset id.",
        )

    partial_u = _dedupe_asset_pairs(partial)
    if len(partial_u) == 1:
        return partial_u[0]
    if len(partial_u) > 1:
        names = ", ".join(k for k, _ in partial_u)
        die(
            f"ambiguous video “{video_name}” matches: {names}",
            hint="Narrow the name so it matches only one source (e.g. full filename or asset id).",
        )
    return None


def find_video_across_folders(
    state: dict[str, Any], needle: str
) -> tuple[str, str, dict[str, Any]] | None:
    """Resolve needle to a unique (folder_key, source_name, meta) across all registrations."""
    exact_hits: list[tuple[str, str, dict[str, Any]]] = []
    partial_hits: list[tuple[str, str, dict[str, Any]]] = []

    for folder_key, prev in (state.get("folders") or {}).items():
        if not isinstance(prev, dict):
            continue
        assets = prev.get("assets") or {}
        if not isinstance(assets, dict):
            continue
        exact, partial = collect_asset_matches(assets, needle)
        for src_name, meta in exact:
            exact_hits.append((folder_key, src_name, meta))
        for src_name, meta in partial:
            partial_hits.append((folder_key, src_name, meta))

    exact_u = _dedupe_folder_hits(exact_hits)
    if len(exact_u) == 1:
        return exact_u[0]
    if len(exact_u) > 1:
        desc = ", ".join(f"{s} ({f})" for f, s, _ in exact_u)
        die(
            f"ambiguous video “{needle}” matches: {desc}",
            hint="Pass the asset UUID from macpaper list, or folder + filename.",
        )

    partial_u = _dedupe_folder_hits(partial_hits)
    if len(partial_u) == 1:
        return partial_u[0]
    if len(partial_u) > 1:
        desc = ", ".join(f"{s} ({f})" for f, s, _ in partial_u)
        die(
            f"ambiguous video “{needle}” matches: {desc}",
            hint="Pass the asset UUID from macpaper list, or folder + filename.",
        )
    return None


def resolve_unregister_folder(
    state: dict[str, Any], token: str
) -> tuple[str, dict[str, Any]] | None:
    """If token is a tracked folder path, return (key, prev)."""
    if looks_like_uuid(token):
        return None
    folder = Path(normalize_path(token))
    key, prev = lookup_folder_state(state, folder)
    if prev:
        return key, prev
    return None


def confirm_unregister(message: str, *, assume_yes: bool) -> bool:
    """Ask before destructive unregister. Returns True if allowed to proceed."""
    if assume_yes:
        return True
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        die(
            "refusing to unregister without confirmation in non-interactive mode",
            hint=f"Re-run with {S.cyan('--yes')} to confirm.",
        )
    info(message)
    return _prompt_yes_no("Proceed?", default=False)


def delete_asset_media(asset_id: str, local_transcode: str | None = None) -> list[str]:
    """Delete aerial encode, thumbnail, and optional local transcoded copy."""
    deleted: list[str] = []
    for p in (VIDEOS_DIR / f"{asset_id}.mov", THUMBS_DIR / f"{asset_id}.png"):
        if p.exists():
            p.unlink()
            deleted.append(str(p))
    if local_transcode:
        lp = Path(local_transcode)
        if lp.exists() and TRANSCODED_DIR_NAME in lp.parts:
            lp.unlink()
            deleted.append(str(lp))
    return deleted


def build_asset(
    *,
    asset_id: str,
    title: str,
    category_id: str,
    subcategory_id: str,
    video_path: Path,
    thumb_path: Path,
    order: int,
) -> dict[str, Any]:
    short = asset_id.replace("-", "")[-6:]
    return {
        "accessibilityLabel": title,
        "categories": [category_id],
        "id": asset_id,
        "includeInShuffle": True,
        "localizedNameKey": title,
        "pointsOfInterest": {"0": f"{SHOT_PREFIX}_{short}_0"},
        "preferredOrder": order,
        "previewImage": file_url(thumb_path),
        "shotID": f"{SHOT_PREFIX}_{short}",
        "showInTopLevel": True,
        "subcategories": [subcategory_id],
        "url-4K-SDR-240FPS": file_url(video_path),
    }


def build_category(
    *,
    category_id: str,
    subcategory_id: str,
    name: str,
    representative_id: str,
    preview_url: str,
) -> dict[str, Any]:
    return {
        "id": category_id,
        "localizedDescriptionKey": name,
        "localizedNameKey": name,
        "preferredOrder": 0,
        "previewImage": preview_url,
        "representativeAssetID": representative_id,
        "subcategories": [
            {
                "id": subcategory_id,
                "localizedDescriptionKey": name,
                "localizedNameKey": name,
                "preferredOrder": 0,
                "previewImage": preview_url,
                "representativeAssetID": representative_id,
            }
        ],
    }


def ensure_helper() -> Path:
    HELPER_BIN.parent.mkdir(parents=True, exist_ok=True)
    if HELPER_BIN.exists() and HELPER_BIN.stat().st_mtime >= HELPER_SRC.stat().st_mtime:
        return HELPER_BIN
    if not HELPER_SRC.exists():
        die(f"Swift helper missing: {HELPER_SRC}")
    info("Compiling ImageFolderHelper (one-time)…")
    r = subprocess.run(
        ["swiftc", "-O", "-o", str(HELPER_BIN), str(HELPER_SRC)],
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        die(f"swiftc failed:\n{r.stderr}")
    return HELPER_BIN


def make_image_folder_entry_blob(folder: Path) -> bytes:
    helper = ensure_helper()
    r = subprocess.run(
        [str(helper), "entry", str(folder.resolve())],
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        die(f"bookmark helper failed:\n{r.stderr.strip() or r.stdout}")
    return base64.b64decode(r.stdout.strip())


def load_image_plist() -> dict[str, Any]:
    if not IMAGE_PLIST.exists():
        return {
            "ChoiceRequests.Assets": [],
            "ChoiceRequests.CollectionIdentifiers": [],
            "ChoiceRequests.ImageFiles": [],
            "ChoiceRequests.ImageFolders": [],
            "ChoiceRequests.PersonIdentifiers": [],
            "DidPerformImagesContainerMigration": True,
            "DidPerformPhotosContainerMigration": True,
            "DidPerformPhotosMigration": True,
        }
    with IMAGE_PLIST.open("rb") as f:
        return plistlib.load(f)


def save_image_plist(data: dict[str, Any]) -> None:
    IMAGE_PLIST.parent.mkdir(parents=True, exist_ok=True)
    with IMAGE_PLIST.open("wb") as f:
        plistlib.dump(data, f, fmt=plistlib.FMT_BINARY)


def path_from_folder_entry(blob: bytes) -> str | None:
    try:
        entry = plistlib.loads(blob)
        rel = (entry.get("originalURL") or {}).get("relative")
        if not rel:
            return None
        # file:///path/
        if rel.startswith("file://"):
            from urllib.parse import unquote, urlparse

            return unquote(urlparse(rel).path).rstrip("/")
        return None
    except Exception:
        return None


def register_image_folder(folder: Path) -> bool:
    """Return True if newly added, False if already present."""
    data = load_image_plist()
    folders: list[bytes] = list(data.get("ChoiceRequests.ImageFolders") or [])
    target = normalize_path(folder)
    for blob in folders:
        existing = path_from_folder_entry(blob)
        if existing and normalize_path(existing) == target:
            return False
    folders.append(make_image_folder_entry_blob(folder))
    data["ChoiceRequests.ImageFolders"] = folders
    save_image_plist(data)
    return True


def unregister_image_folder(folder: Path) -> bool:
    data = load_image_plist()
    folders: list[bytes] = list(data.get("ChoiceRequests.ImageFolders") or [])
    target = normalize_path(folder)
    new_folders = []
    removed = False
    for blob in folders:
        existing = path_from_folder_entry(blob)
        if existing and normalize_path(existing) == target:
            removed = True
            continue
        new_folders.append(blob)
    if removed:
        data["ChoiceRequests.ImageFolders"] = new_folders
        save_image_plist(data)
    return removed


def cmd_register(args: argparse.Namespace) -> None:
    folder = Path(normalize_path(args.folder))
    if not folder.is_dir():
        die(f"not a directory: {folder}")

    videos, images = scan_folder(folder)
    if not videos and not images:
        die(f"no video/image files found in {folder}")

    info(f"Folder: {folder}")
    info(f"Found {len(videos)} video(s), {len(images)} image(s)")

    state = load_state()
    key = normalize_path(folder)
    category_id = deterministic_uuid(f"category:{key}")
    subcategory_id = deterministic_uuid(f"subcategory:{key}")
    cat_name = args.name or folder.name

    registered_assets: dict[str, Any] = {}
    did_videos = False
    did_images = False

    if videos and not args.images_only:
        ensure_aerials_ready()
        entries = load_entries()
        save_transcoded = resolve_save_transcoded(args)
        if save_transcoded:
            info(f"Local copies will be saved under {folder / TRANSCODED_DIR_NAME}/")

        # Drop previous registration for this folder
        prev = state.get("folders", {}).get(key, {})
        old_cat = prev.get("category_id", category_id)
        old_sub = prev.get("subcategory_id", subcategory_id)
        removed = remove_category_assets(entries, old_cat, old_sub)
        for aid in removed:
            for p in (VIDEOS_DIR / f"{aid}.mov", THUMBS_DIR / f"{aid}.png"):
                if p.exists():
                    p.unlink()

        new_assets: list[dict[str, Any]] = []
        for i, src in enumerate(videos):
            asset_id = deterministic_uuid(f"asset:{key}:{src.name}")
            dest = VIDEOS_DIR / f"{asset_id}.mov"
            thumb = THUMBS_DIR / f"{asset_id}.png"
            title = display_title(src)
            info(f"[{i + 1}/{len(videos)}] {src.name}")
            if args.dry_run:
                probe = probe_video(src)
                if args.force_transcode:
                    info(f"  would force-transcode ({getattr(args, 'quality', DEFAULT_QUALITY)})")
                elif args.no_transcode or probe.get("ready"):
                    info(f"  would skip transcode — {probe.get('reason')}")
                else:
                    info(f"  would transcode — {probe.get('reason')}")
                registered_assets[src.name] = {"id": asset_id, "title": title, "kind": "video"}
                if save_transcoded:
                    info(f"  would save {TRANSCODED_DIR_NAME}/{src.stem}.mov")
                continue
            transcode_or_copy(
                src,
                dest,
                force_transcode=args.force_transcode,
                skip_transcode=args.no_transcode,
                quality=getattr(args, "quality", DEFAULT_QUALITY),
            )
            make_thumbnail(dest, thumb)
            new_assets.append(
                build_asset(
                    asset_id=asset_id,
                    title=title,
                    category_id=category_id,
                    subcategory_id=subcategory_id,
                    video_path=dest,
                    thumb_path=thumb,
                    order=i,
                )
            )
            entry: dict[str, Any] = {
                "id": asset_id,
                "title": title,
                "kind": "video",
                "source": str(src),
                "aerial": str(dest),
            }
            if save_transcoded:
                local = save_local_transcode_copy(src, dest, folder)
                entry["local_transcode"] = str(local)
            registered_assets[src.name] = entry

        if not args.dry_run and new_assets:
            preview = new_assets[0]["previewImage"]
            rep = new_assets[0]["id"]
            entries.setdefault("assets", []).extend(new_assets)
            # Put our category first so it's easy to find
            cat = build_category(
                category_id=category_id,
                subcategory_id=subcategory_id,
                name=cat_name,
                representative_id=rep,
                preview_url=preview,
            )
            entries["categories"] = [cat] + list(entries.get("categories") or [])
            save_entries(entries)
            did_videos = True
            info(f"Registered {len(new_assets)} video(s) under category “{cat_name}”")

    if images and not args.videos_only:
        if args.dry_run:
            info(f"Would register image folder: {folder}")
            did_images = True
        else:
            added = register_image_folder(folder)
            did_images = True
            if added:
                info("Registered folder for still images in System Settings → Wallpaper")
            else:
                info("Image folder already registered in System Settings")

    if args.dry_run:
        info("Dry run — no changes written.")
        return

    state.setdefault("folders", {})[key] = {
        "category_id": category_id,
        "subcategory_id": subcategory_id,
        "name": cat_name,
        "assets": registered_assets,
        "image_folder_registered": bool(images and not args.videos_only),
        "updated_at": datetime.now(timezone.utc).isoformat(),
    }
    save_state(state)

    if (did_videos or did_images) and not args.no_restart:
        restart_wallpaper_services()

    info("")
    ok("Done. Open System Settings → Wallpaper (and Screen Saver).")
    if did_videos:
        info(f"  Videos appear under the “{cat_name}” aerial collection.")
    if did_images:
        info(f"  Images appear from the registered folder “{folder.name}”.")
    info(f"  {S.dim('Tip:')} run {S.cyan('macpaper list')} to confirm.")


def cmd_unregister(args: argparse.Namespace) -> None:
    """Unregister a whole folder, or a single video resolved across registrations.

    Accepts:
      - registered folder path → remove entire folder
      - asset UUID / source path / filename / title → remove that one video
    """
    token = str(args.folder).strip()
    state = load_state()

    folder_hit = resolve_unregister_folder(state, token)
    if folder_hit:
        key, prev = folder_hit
        folder = Path(key)
        return _unregister_folder(
            state=state,
            key=key,
            prev=prev,
            folder=folder,
            force=bool(args.force),
            assume_yes=getattr(args, "yes", False),
            no_restart=bool(args.no_restart),
            dry_run=getattr(args, "dry_run", False),
        )

    video_hit = find_video_across_folders(state, token)
    if video_hit:
        folder_key, src_name, _meta = video_hit
        info(
            f"Matched video {S.cyan(src_name)} in {S.cyan(folder_key)} "
            f"(removing that video only)"
        )
        return cmd_unregister_video(
            argparse.Namespace(
                folder=folder_key,
                video=src_name,
                dry_run=getattr(args, "dry_run", False),
                yes=getattr(args, "yes", False),
                no_restart=getattr(args, "no_restart", False),
            )
        )

    if args.force and not looks_like_uuid(token):
        folder = Path(normalize_path(token))
        key = normalize_path(folder)
        return _unregister_folder(
            state=state,
            key=key,
            prev=None,
            folder=folder,
            force=True,
            assume_yes=getattr(args, "yes", False),
            no_restart=bool(args.no_restart),
            dry_run=getattr(args, "dry_run", False),
        )

    die(
        f"nothing registered matching “{token}”",
        hint=(
            f"Pass a registered folder path, asset UUID, source path, or filename "
            f"(see {S.cyan('macpaper list')})."
        ),
    )


def _unregister_folder(
    *,
    state: dict[str, Any],
    key: str,
    prev: dict[str, Any] | None,
    folder: Path,
    force: bool,
    assume_yes: bool,
    no_restart: bool,
    dry_run: bool,
) -> None:
    if not prev and not force:
        die(
            f"folder not tracked by macpaper: {folder}",
            hint=(
                f"Pass the registered folder path (see {S.cyan('macpaper list')}), "
                f"an asset UUID / video name, or {S.cyan('--force')}."
            ),
        )

    category_id = (prev or {}).get("category_id") or deterministic_uuid(f"category:{normalize_path(folder)}")
    subcategory_id = (prev or {}).get("subcategory_id") or deterministic_uuid(
        f"subcategory:{normalize_path(folder)}"
    )

    n_videos = len((prev or {}).get("assets") or {})
    summary = (
        f"Unregister entire folder {S.cyan(str(folder))}\n"
        f"  This removes all {n_videos} tracked video(s) and any image-folder registration."
    )
    if dry_run:
        info(
            f"Would unregister folder {folder} "
            f"({n_videos} video(s), category {category_id})"
        )
        return

    if not confirm_unregister(summary, assume_yes=assume_yes):
        info(S.dim("Cancelled."))
        return

    if ENTRIES.exists():
        entries = load_entries()
        removed = remove_category_assets(entries, category_id, subcategory_id)
        save_entries(entries)
        for aid in removed:
            local = None
            if prev:
                for meta in (prev.get("assets") or {}).values():
                    if isinstance(meta, dict) and meta.get("id") == aid:
                        local = meta.get("local_transcode")
                        break
            delete_asset_media(aid, str(local) if local else None)
        info(f"Removed {len(removed)} aerial asset(s)")

    if unregister_image_folder(folder):
        info("Removed image folder registration")
    else:
        info("No image folder registration found")

    if key in state.get("folders", {}):
        del state["folders"][key]
        save_state(state)

    if not no_restart:
        restart_wallpaper_services()
    ok("Unregistered folder.")


def cmd_unregister_video(args: argparse.Namespace) -> None:
    """Remove a single source video's aerial listing and encodes only.

    Accepts:
      - <folder> <video> — scoped lookup
      - <video|asset-id|path> alone — search all registered folders
    """
    state = load_state()
    folder_arg = getattr(args, "folder", None)
    video_arg = getattr(args, "video", None)

    if folder_arg is None:
        die(
            "missing video target",
            hint=f"Usage: {S.cyan('macpaper unregister-video <asset-id|path|name>')}\n"
            f"   or: {S.cyan('macpaper unregister-video <folder> <name>')}",
        )

    folder_token = str(folder_arg).strip()
    video_token = str(video_arg).strip() if video_arg else None
    query_label = video_token or folder_token

    if video_token is None:
        hit = find_video_across_folders(state, folder_token)
        if not hit:
            die(
                f"video “{folder_token}” not found in any registered folder",
                hint=f"Check {S.cyan('macpaper list')}.",
            )
        key, asset_key, meta = hit
        prev = (state.get("folders") or {}).get(key) or {}
        info(f"Matched in {S.cyan(key)}")
    else:
        folder_hit = resolve_unregister_folder(state, folder_token)
        if folder_hit:
            key, prev = folder_hit
            assets = dict(prev.get("assets") or {})
            if not assets:
                die("no videos tracked for this folder", hint="Nothing to remove.")
            matched = match_tracked_asset(assets, video_token)
            if not matched:
                known = ", ".join(sorted(assets.keys())) or "(none)"
                die(
                    f"video “{video_token}” not found in macpaper state for this folder",
                    hint=f"Tracked sources: {known}",
                )
            asset_key, meta = matched
        else:
            needle = folder_token if looks_like_uuid(folder_token) else video_token
            hit = find_video_across_folders(state, needle)
            if not hit and needle != video_token:
                hit = find_video_across_folders(state, video_token)
            if not hit:
                hit = find_video_across_folders(state, folder_token)
            if not hit:
                die(
                    f"video “{query_label}” not found in any registered folder",
                    hint=f"Check {S.cyan('macpaper list')}.",
                )
            key, asset_key, meta = hit
            prev = (state.get("folders") or {}).get(key) or {}
            info(f"Matched in {S.cyan(key)}")

    asset_id = meta.get("id")
    if not asset_id:
        die(f"tracked entry for “{asset_key}” has no asset id")

    category_id = prev.get("category_id") or deterministic_uuid(f"category:{key}")
    folder = Path(key)
    local_tc = meta.get("local_transcode")
    if not local_tc:
        candidate = folder / TRANSCODED_DIR_NAME / f"{Path(asset_key).stem}.mov"
        if candidate.exists():
            local_tc = str(candidate)

    if args.dry_run:
        info(f"Would remove aerial for {asset_key} ({asset_id})")
        if local_tc:
            info(f"Would delete local copy {local_tc}")
        return

    summary = f"Unregister video {S.cyan(asset_key)}"
    if query_label != asset_key:
        summary += f"  {S.dim(f'(matched from “{query_label}”)')}"
    summary += f"\n  aerial id: {S.dim(str(asset_id))}"
    summary += f"\n  folder: {S.dim(key)}"
    if local_tc:
        summary += f"\n  local copy: {S.dim(str(local_tc))}"
    summary += "\n  Other videos in this folder will be left alone."
    if not confirm_unregister(summary, assume_yes=getattr(args, "yes", False)):
        info(S.dim("Cancelled."))
        return

    if ENTRIES.exists():
        entries = load_entries()
        if remove_single_asset(entries, asset_id=asset_id, category_id=category_id):
            save_entries(entries)
            info(f"Removed aerial listing for {asset_key}")
        else:
            warn(f"Asset {asset_id} was not present in entries.json (cleaning files/state anyway)")

    deleted = delete_asset_media(str(asset_id), str(local_tc) if local_tc else None)
    for path in deleted:
        info(f"Deleted {path}")

    assets = dict(prev.get("assets") or {})
    if asset_key in assets:
        del assets[asset_key]
    prev["assets"] = assets
    prev["updated_at"] = datetime.now(timezone.utc).isoformat()
    state.setdefault("folders", {})[key] = prev
    if not assets and not prev.get("image_folder_registered"):
        del state["folders"][key]
        info("No media left for this folder — cleared macpaper state entry")
    save_state(state)

    if not args.no_restart:
        restart_wallpaper_services()
    ok(f"Unregistered video “{asset_key}”. Other videos untouched.")



def is_macpaper_asset(asset: dict[str, Any], owned_ids: set[str] | None = None) -> bool:
    """True if this aerial entry was authored by macpaper."""
    if owned_ids is not None and asset.get("id") in owned_ids:
        return True
    shot = str(asset.get("shotID") or "")
    if shot.startswith(f"{SHOT_PREFIX}_"):
        return True
    # Deterministic IDs from our namespace always use version-5 UUID layout with
    # our CAT_NAMESPACE; also accept assets whose category id is tracked in state.
    return False


def owned_ids_from_state(state: dict[str, Any]) -> set[str]:
    ids: set[str] = set()
    for meta in (state.get("folders") or {}).values():
        if meta.get("category_id"):
            ids.add(meta["category_id"])
        if meta.get("subcategory_id"):
            ids.add(meta["subcategory_id"])
        for asset in (meta.get("assets") or {}).values():
            if isinstance(asset, dict) and asset.get("id"):
                ids.add(asset["id"])
    return ids


def cmd_list(_: argparse.Namespace) -> None:
    state = load_state()
    folders = state.get("folders") or {}
    owned = owned_ids_from_state(state)

    if not folders:
        info(S.dim("No folders registered via macpaper."))
    else:
        info(S.bold("Tracked by macpaper:"))
        for path, meta in folders.items():
            assets = meta.get("assets") or {}
            info(f"  {S.cyan(path)}")
            info(f"    category: {meta.get('name')} ({S.dim(str(meta.get('category_id')))})")
            info(f"    videos:   {len(assets)}")
            for name in sorted(assets.keys()):
                info(f"      • {name}")
            info(f"    images:   {'yes' if meta.get('image_folder_registered') else 'no'}")

    # Image folders macpaper registered (intersection with state when possible)
    macpaper_image_folders = {
        normalize_path(p)
        for p, meta in folders.items()
        if meta.get("image_folder_registered")
    }
    if IMAGE_PLIST.exists():
        data = load_image_plist()
        live = []
        for blob in data.get("ChoiceRequests.ImageFolders") or []:
            p = path_from_folder_entry(blob)
            if not p:
                continue
            # Prefer showing folders we track; if none tracked, show none from us
            if macpaper_image_folders and normalize_path(p) in macpaper_image_folders:
                live.append(p)
            elif not macpaper_image_folders and folders:
                # state says we registered images but path normalize mismatch — show all
                # only if this folder key is under our state paths
                pass
        info("")
        info(S.bold("macpaper image folders in System Settings:"))
        if not live:
            info(S.dim("  (none)"))
        for p in live:
            info(f"  {p}")

    # Only macpaper aerial assets — never list other apps' custom entries
    if ENTRIES.exists():
        entries = load_entries()
        ours = [a for a in entries.get("assets") or [] if is_macpaper_asset(a, owned)]
        info("")
        info(S.bold(f"macpaper aerial assets: {len(ours)}"))
        if not ours:
            info(S.dim("  (none)"))
        for a in ours:
            aid = a.get("id")
            info(f"  {a.get('localizedNameKey')}  {S.dim(f'({aid})')}")
    else:
        info("")
        warn(f"Aerial manifest not found yet at {ENTRIES}")
        info(S.dim("  Download one built-in aerial in System Settings first."))


def cmd_check(args: argparse.Namespace) -> None:
    """Report whether path(s) are full aerial-ready (HEVC + temporal layers)."""
    target = Path(args.path).expanduser().resolve()
    if not target.exists():
        die(f"not found: {target}")

    files: list[Path] = []
    if target.is_file():
        if target.suffix.lower() not in VIDEO_EXTS:
            die(f"not a known video type: {target.suffix}")
        files = [target]
    elif target.is_dir():
        videos, _ = scan_folder(target)
        files = videos
        if not files:
            die(f"no video files in {target}")
    else:
        die(f"not a file or directory: {target}")

    ready_n = 0
    screensaver_n = 0
    for f in files:
        p = probe_video(f)
        ready = bool(p.get("ready"))
        ss_ok = bool(p.get("screensaver_ok"))
        ready_n += int(ready)
        screensaver_n += int(ss_ok)
        if ready:
            mark = S.green("ready")
        elif ss_ok:
            mark = S.yellow("screensaver only")
        else:
            mark = S.yellow("needs encode")
        info(f"{S.bold(f.name)}  [{mark}]")
        info(f"  {p.get('reason')}")
        dims = ""
        if p.get("width") and p.get("height"):
            dims = f"  {p['width']}x{p['height']}"
        temporal = "yes" if p.get("has_temporal") else "no"
        dur = p.get("duration")
        dur_s = f"  duration={dur:.1f}s" if isinstance(dur, (int, float)) else ""
        info(
            f"  codec={p.get('codec') or '?'}  tag={p.get('tag') or '?'}  "
            f"format={p.get('format') or '?'}{dims}  temporal={temporal}{dur_s}"
        )
        if ready:
            info(f"  tip: register with {S.cyan('--no-transcode')} to avoid re-encoding")
        elif ss_ok:
            info(
                f"  tip: register (default) re-encodes with temporal layers so "
                f"stop-screensaver → wallpaper works; use {S.cyan('--force-transcode')} "
                f"to refresh already-registered clips"
            )
        else:
            info(f"  tip: register with {S.cyan(f'--quality {DEFAULT_QUALITY}')} (or max)")
        info("")

    info(
        S.bold(
            f"{ready_n}/{len(files)} full ready (screensaver + wallpaper freeze); "
            f"{screensaver_n}/{len(files)} HEVC for screensaver"
        )
    )


