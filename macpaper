def restart_wallpaper_services() -> None:
    for name in ("cfprefsd", "WallpaperAgent"):
        subprocess.run(
            ["/usr/bin/killall", name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    info("Restarted WallpaperAgent / cfprefsd — reopen System Settings if it was open.")


def has_temporal_layers(path: Path) -> bool:
    """True if the file has HEVC temporal sample groups (tscl + tsas).

    WallpaperAgent's unlock / stop-screensaver ramp requires these; plain HEVC
    from ffmpeg plays as screensaver but cannot freeze the frame as wallpaper.
    """
    try:
        size = path.stat().st_size
        if size <= 0:
            return False
        with path.open("rb") as f:
            head_n = min(size, 8_000_000)
            head = f.read(head_n)
            if size <= head_n:
                data = head
            else:
                f.seek(max(0, size - 12_000_000))
                data = head + f.read()
        return b"tscl" in data and b"tsas" in data
    except OSError:
        return False


def aerial_loop_count(duration_sec: float | None) -> int:
    """Loop short clips so the encode is long enough for wallpaper freeze."""
    if not duration_sec or duration_sec <= 0:
        return 1
    if duration_sec >= TARGET_AERIAL_SECONDS:
        return 1
    return max(1, int(math.ceil(TARGET_AERIAL_SECONDS / duration_sec)))


def probe_video(path: Path) -> dict[str, Any]:
    """Return codec/container info and whether the file is full aerial-ready.

    Full ready = HEVC in QT/MP4 family + temporal sub-layers (tscl/tsas).
    HEVC without temporal layers works as screensaver only.
    """
    info_out: dict[str, Any] = {
        "path": str(path),
        "ready": False,
        "needs_transcode": True,
        "screensaver_ok": False,
        "has_temporal": False,
        "reason": "unreadable",
        "codec": None,
        "tag": None,
        "format": None,
        "width": None,
        "height": None,
        "fps": None,
        "duration": None,
    }
    try:
        out = subprocess.check_output(
            [
                "ffprobe",
                "-v",
                "error",
                "-select_streams",
                "v:0",
                "-show_entries",
                "stream=codec_name,codec_tag_string,width,height,r_frame_rate"
                ":format=format_name,duration",
                "-of",
                "json",
                str(path),
            ],
            text=True,
        )
        meta = json.loads(out)
    except (subprocess.CalledProcessError, FileNotFoundError, json.JSONDecodeError) as e:
        info_out["reason"] = f"ffprobe failed ({e})"
        return info_out

    streams = meta.get("streams") or []
    if not streams:
        info_out["reason"] = "no video stream"
        return info_out

    stream = streams[0]
    codec = (stream.get("codec_name") or "").lower()
    tag = (stream.get("codec_tag_string") or "").lower()
    fmt_meta = meta.get("format") or {}
    fmt = fmt_meta.get("format_name") or ""
    duration: float | None = None
    try:
        duration = float(fmt_meta.get("duration") or 0) or None
    except (TypeError, ValueError):
        duration = None
    info_out.update(
        {
            "codec": codec,
            "tag": tag,
            "format": fmt,
            "width": stream.get("width"),
            "height": stream.get("height"),
            "fps": stream.get("r_frame_rate"),
            "duration": duration,
        }
    )

    is_hevc = codec in {"hevc", "h265"}
    # QuickTime / MP4 family — ffprobe often reports "mov,mp4,m4a,..."
    is_qt_family = (
        path.suffix.lower() in {".mov", ".mp4", ".m4v"}
        or "mov" in fmt
        or "mp4" in fmt
    )
    is_mov_ext = path.suffix.lower() == ".mov"

    if not is_hevc:
        info_out["reason"] = f"codec is {codec or 'unknown'} (aerials want HEVC/H.265)"
        return info_out
    if not is_qt_family:
        info_out["reason"] = f"container is {fmt or path.suffix} (want .mov / MP4 family)"
        return info_out

    info_out["screensaver_ok"] = True
    temporal = has_temporal_layers(path)
    info_out["has_temporal"] = temporal

    notes = []
    if not is_mov_ext:
        notes.append("not .mov (usually OK if HEVC; remux to .mov if Settings rejects it)")
    if tag and tag not in {"hvc1", "hev1", "hvcC"}:
        notes.append(f"tag is {tag} (hvc1 is ideal)")
    elif tag == "hev1":
        notes.append("tag hev1 (hvc1 preferred but usually plays)")

    if not temporal:
        info_out["ready"] = False
        info_out["needs_transcode"] = True
        info_out["reason"] = (
            "HEVC OK for screensaver, but missing temporal layers "
            "(tscl/tsas) — wallpaper freeze / unlock ramp needs encode_temporal"
        )
        if notes:
            info_out["reason"] += f" — {'; '.join(notes)}"
        return info_out

    info_out["ready"] = True
    info_out["needs_transcode"] = False
    info_out["reason"] = "ready for screensaver + wallpaper freeze" + (
        f" — {'; '.join(notes)}" if notes else ""
    )
    return info_out


def needs_transcode(path: Path) -> bool:
    """Return True unless the file is full aerial-ready (HEVC + temporal layers)."""
    return bool(probe_video(path).get("needs_transcode", True))


def quality_settings(name: str | None) -> dict[str, str]:
    key = (name or DEFAULT_QUALITY).lower()
    if key not in QUALITY_PRESETS:
        die(
            f"unknown quality “{name}”",
            hint=f"Choose one of: {', '.join(QUALITY_PRESETS)}",
        )
    return QUALITY_PRESETS[key]


def ensure_encode_temporal() -> Path:
    """Compile the VideoToolbox temporal HEVC encoder on demand."""
    ENCODE_TEMPORAL_BIN.parent.mkdir(parents=True, exist_ok=True)
    if (
        ENCODE_TEMPORAL_BIN.exists()
        and ENCODE_TEMPORAL_SRC.exists()
        and ENCODE_TEMPORAL_BIN.stat().st_mtime >= ENCODE_TEMPORAL_SRC.stat().st_mtime
    ):
        return ENCODE_TEMPORAL_BIN
    if not ENCODE_TEMPORAL_SRC.exists():
        die(f"Swift encoder missing: {ENCODE_TEMPORAL_SRC}")
    info("Compiling encode_temporal (one-time)…")
    r = subprocess.run(
        ["swiftc", "-O", "-o", str(ENCODE_TEMPORAL_BIN), str(ENCODE_TEMPORAL_SRC)],
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        die(
            f"swiftc failed for encode_temporal:\n{r.stderr}",
            hint="Install Xcode Command Line Tools: xcode-select --install",
        )
    return ENCODE_TEMPORAL_BIN


def encode_temporal_hevc(
    src: Path,
    dest: Path,
    *,
    quality: str = DEFAULT_QUALITY,
    duration: float | None = None,
    target_fps: int = TARGET_AERIAL_FPS,
    loops: int | None = None,
) -> None:
    """Encode with temporal sub-layers so wallpaper freeze / unlock ramp works."""
    q = quality_settings(quality)
    loop_n = aerial_loop_count(duration) if loops is None else max(1, loops)
    mbps = q["mbps"]
    encoder = ensure_encode_temporal()
    loop_note = f", looping ×{loop_n} (~{TARGET_AERIAL_SECONDS}s)" if loop_n > 1 else ""
    fps_note = f", target {target_fps} fps" if target_fps else ""
    info(f"  encoding {src.name} → temporal HEVC ({q['label']}{loop_note}{fps_note}) …")
    r = subprocess.run(
        [str(encoder), str(src), str(dest), str(loop_n), mbps, str(target_fps)],
        capture_output=True,
        text=True,
    )
    if r.returncode != 0 or not dest.exists() or dest.stat().st_size < 1024:
        err = (r.stderr or r.stdout or "").strip()[-2000:]
        die(f"encode_temporal failed for {src.name}:\n{err}")
    if not has_temporal_layers(dest):
        die(
            f"encode_temporal wrote {dest.name} but tscl/tsas are missing",
            hint="Wallpaper freeze will not work; file a bug with macOS / hardware details",
        )


def transcode_or_copy(
    src: Path,
    dest: Path,
    *,
    force_transcode: bool,
    skip_transcode: bool,
    quality: str = DEFAULT_QUALITY,
) -> bool:
    """Write dest from src. Returns True if a re-encode ran.

    Probes like `macpaper check`. Skips encode only when HEVC already has
    temporal layers (unless --force-transcode). Otherwise uses encode_temporal
    (VideoToolbox Main10 + BaseLayerFrameRate) — ffmpeg alone cannot emit tscl/tsas.
    """
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.exists():
        dest.unlink()

    probe = probe_video(src)
    ready = bool(probe.get("ready"))

    if force_transcode:
        do_transcode = True
        info(f"  check: {S.yellow('force transcode')} ({probe.get('codec')}/{probe.get('tag')})")
    elif skip_transcode:
        do_transcode = False
        info(f"  check: {S.dim('skip encode (--no-transcode)')} — {probe.get('reason')}")
        if probe.get("screensaver_ok") and not probe.get("has_temporal"):
            warn(
                "  skipping temporal encode — screensaver will work; "
                "wallpaper freeze / unlock ramp will not"
            )
    elif ready:
        do_transcode = False
        info(f"  check: {S.green('ready')} — skipping transcode")
        info(f"  {S.dim(str(probe.get('reason')))}")
    else:
        do_transcode = True
        info(f"  check: {S.yellow('needs encode')} — {probe.get('reason')}")

    if not do_transcode:
        # Prefer hardlink to save disk; fall back to copy.
        try:
            os.link(src, dest)
            info(f"  linked  {src.name} → {dest.name}")
            return False
        except OSError:
            shutil.copy2(src, dest)
            info(f"  copied  {src.name} → {dest.name}")
            return False

    encode_temporal_hevc(
        src,
        dest,
        quality=quality,
        duration=probe.get("duration") if isinstance(probe.get("duration"), (int, float)) else None,
    )
    return True


def make_thumbnail(video: Path, thumb: Path) -> None:
    thumb.parent.mkdir(parents=True, exist_ok=True)
    if thumb.exists():
        thumb.unlink()
    # Grab a frame ~1s in (or first frame if shorter)
    cmd = [
        "ffmpeg",
        "-y",
        "-ss",
        "1",
        "-i",
        str(video),
        "-frames:v",
        "1",
        "-vf",
        "scale='min(1920,iw)':-2",
        str(thumb),
    ]
    r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if r.returncode != 0 or not thumb.exists():
        cmd[3] = "0"
        r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        if r.returncode != 0 or not thumb.exists():
            die(f"thumbnail failed for {video.name}:\n{r.stderr[-1500:]}")


