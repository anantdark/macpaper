def _prompt(label: str, default: str | None = None) -> str:
    suffix = f" [{default}]" if default else ""
    try:
        raw = input(f"  {S.cyan('›')} {label}{suffix}: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        raise SystemExit(130)
    if not raw and default is not None:
        return default
    return raw


def _prompt_yes_no(label: str, default: bool = False) -> bool:
    hint = "Y/n" if default else "y/N"
    ans = _prompt(f"{label} ({hint})", "").lower()
    if not ans:
        return default
    return ans in {"y", "yes"}


def interactive_menu() -> list[str]:
    """Guided prompt that returns an argv-like list for the chosen command."""
    print_banner_help()
    if not sys.stdin.isatty():
        return ["help"]

    print(f"  {S.bold('What would you like to do?')}")
    print(f"    {S.cyan('1')}  Register a folder")
    print(f"    {S.cyan('2')}  Unregister a folder")
    print(f"    {S.cyan('3')}  Unregister one video")
    print(f"    {S.cyan('4')}  List registered media")
    print(f"    {S.cyan('5')}  Refresh WallpaperAgent")
    print(f"    {S.cyan('6')}  Quit")
    print()

    choice = _prompt("Choose 1–6", "1")
    mapping = {
        "1": "register",
        "2": "unregister",
        "3": "unregister-video",
        "4": "list",
        "5": "refresh",
        "6": "quit",
        "register": "register",
        "unregister": "unregister",
        "unregister-video": "unregister-video",
        "list": "list",
        "refresh": "refresh",
        "quit": "quit",
        "q": "quit",
    }
    cmd = mapping.get(choice.lower())
    if cmd is None:
        hint = suggest_command(choice)
        die(f"unknown choice “{choice}”", hint=hint or "Enter a number from 1–6.")
    if cmd == "quit":
        print(f"  {S.dim('Bye.')}")
        raise SystemExit(0)

    argv = [cmd]
    if cmd in {"register", "unregister", "unregister-video"}:
        if cmd == "unregister":
            target = _prompt("Folder path, asset UUID, or video name")
            if not target:
                die(
                    "a target is required",
                    hint="Example: ~/Movies/Wallpapers  or  B5F705B9-…  or  clip.mp4",
                )
            argv.append(target)
        elif cmd == "unregister-video":
            target = _prompt("Asset UUID, source path, or video name")
            if not target:
                die("a video target is required", hint="Example: clip.mp4 or an asset UUID from list")
            argv.append(target)
            folder = _prompt("Limit to folder? (Enter to search all)", "")
            if folder:
                # folder + video form
                argv = [cmd, folder, target]
        else:
            folder = _prompt("Folder path")
            if not folder:
                die("a folder path is required", hint="Example: ~/Movies/Wallpapers")
            argv.append(folder)
            name = _prompt("Category name (optional, Enter to skip)", "")
            if name:
                argv.extend(["--name", name])
            if _prompt_yes_no("Videos only?", False):
                argv.append("--videos-only")
            elif _prompt_yes_no("Images only?", False):
                argv.append("--images-only")
            if _prompt_yes_no(f"Also save transcoded videos into ./{TRANSCODED_DIR_NAME}/?", False):
                argv.append("--save-transcoded")
            else:
                argv.append("--no-save-transcoded")
            if _prompt_yes_no("Dry run (preview only)?", False):
                argv.append("--dry-run")
        print()
        print(f"  {S.dim('Running:')} macpaper {' '.join(argv)}")
        print()
    return argv


